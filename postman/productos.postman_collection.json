              "pm.test('Estado 404', () => pm.response.to.have.status(404));",
              "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Error sin detalles internos', () => { const body = pm.response.json(); pm.expect(Object.keys(body)).to.eql(['error']); pm.expect(body.error).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Actualizar producto eliminado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "description": "10 - Actualizar producto eliminado. Respuesta esperada: 404.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuaderno de práctica\",\n  \"descripcion\": \"Producto temporal de Postman\",\n  \"precio\": 12.5,\n  \"stock\": 10\n}",
          "options": {
